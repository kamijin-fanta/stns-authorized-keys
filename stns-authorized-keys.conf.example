api_endpoint = "https://stns.example.com/v1"
auth_token = "replace-me"
ssl_verify = true
request_timeout = 3
request_retry = 3
request_locktime = 5
request_concurrency = 10
log_level = "info"

[tls]
# ca = "/etc/stns-authorized-keys/ca.pem"
# cert = "/etc/stns-authorized-keys/client.crt"
# key = "/etc/stns-authorized-keys/client-key.key"

[cached]
enable = true
cache_dir = "/run/stns-authorized-keys"
cache_ttl = 300
stale_if_error = 86400

[users.admin]
link_users = ["user-name"]
link_groups = ["group-name"]
